rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Oliveira Frota: somente usuários autenticados no Firebase
    // podem ler ou gravar os dados da frota.
    match /fleets/oliveira-frota/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
